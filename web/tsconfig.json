{
  /*
   * Authoritative TypeScript config for the dashboard (`npm run typecheck` -> `tsc -b`).
   *
   * Deliberately self-contained rather than a solution file with project
   * references: the strictness floor below (notably `exactOptionalPropertyTypes`)
   * is a contract every `web/src` module is written against, and project
   * references do not inherit compilerOptions, so a single project is the only
   * way to guarantee one uniform strictness level across src + build configs.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    /* language + module system (bundler-driven, Vite emits) */
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],

    /* strictness — the whole ladder, on purpose */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* `@/*` -> `web/src/*` — mirrored in vite.config.ts and vitest.config.ts.
     * No `baseUrl`: it is deprecated in TS 6 and removed in TS 7; without it,
     * `paths` values resolve relative to this file, which is what we want. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
