# ── LLM Provider ──
LLM_API_KEY=
LLM_BASE_URL=https://api.nan.builders/v1
LLM_MODEL=deepseek-v4-flash

# ── Search Provider ──────────────────────────────────────────────
# Available: duckduckgo (free, no key), direct (free, no key),
#            hermes (uses Hermes CLI subagent), tavily (needs key),
#            serpapi (needs key), mock (wikipedia only)
SEARCH_PROVIDER=duckduckgo

# Keys for paid search providers (optional):
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# Path to Hermes CLI binary (only needed for SEARCH_PROVIDER=hermes):
# HERMES_PATH=hermes

# ── Database ──
# DATABASE_URL=sqlite+aiosqlite:///./historiador.db

# ── Web Push Notifications (optional) ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=admin@historiador.app

# ── Stytch Authentication ────────────────────────────────────────────
# Get these from https://stytch.com/dashboard → API Keys
STYTCH_PROJECT_ID=
STYTCH_SECRET=
# Public token (safe for frontend, from Stytch dashboard → SDK Configuration)
STYTCH_PUBLIC_TOKEN=
# "test" or "live" (Stytch environment)
STYTCH_ENVIRONMENT=test

# ── MCP Server ───────────────────────────────────────────────────────
MCP_ENABLED=true
MCP_PORT=8081
MCP_HOST=0.0.0.0